<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/mprieto/blog/:blogId" method="GET">
        <service class="Mprieto\Blog\Api\BlogRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/mprieto/blog/:blogId/comments" method="GET">
        <service class="Mprieto\Blog\Api\BlogRepositoryInterface" method="getByIdComments"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/mprieto/blog/:blogId" method="PUT">
        <service class="Mprieto\Blog\Api\BlogRepositoryInterface" method="save"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/mprieto/blog" method="POST">
        <service class="Mprieto\Blog\Api\BlogRepositoryInterface" method="save"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/mprieto/blog/:blogId" method="DELETE">
        <service class="Mprieto\Blog\Api\BlogRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/mprieto/blog/search" method="GET">
        <service class="Mprieto\Blog\Api\BlogRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
