<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mprieto_blog" resource="default" engine="innodb" comment="Mprieto Blog Table">
        <column xsi:type="int" name="blog_id" unsigned="true" nullable="false" identity="true"
                comment="Blog ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Blog name"/>
        <column xsi:type="mediumtext" name="content" nullable="true" comment="Blog Content"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Blog Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Blog Modification Time"/>
        <column xsi:type="smallint" name="is_active" unsigned="false" nullable="false" identity="false"
                default="1" comment="Is Blog Active"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0"
                comment="Store View"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="blog_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MPRIETO_BLOG_STORE_ID_STORE_STORE_ID"
                    table="mprieto_blog" column="store_id"
                    referenceTable="store" referenceColumn="store_id"
                    onDelete="CASCADE"/>
        <index referenceId="MPRIETO_BLOG_NAME_CONTENT" indexType="fulltext">
            <column name="name"/>
            <column name="content"/>
        </index>
    </table>

    <table name="mprieto_blog_comments" resource="default" engine="innodb" comment="Mprieto Blog Comments Table">
        <column xsi:type="int" name="comment_id" identity="true" unsigned="true" nullable="false"
                comment="Comment ID"/>
        <column xsi:type="int" name="blog_id" unsigned="true" nullable="false" comment="Related Blog ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="text" name="comment" nullable="false" comment="Comment Text"/>
        <column xsi:type="smallint" name="status" nullable="false" default="1" comment="Comment Status"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="comment_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="MPRIETO_BLOG_COMMENTS_BLOG_ID_MPRIETO_BLOG_BLOG_ID"
                    table="mprieto_blog_comments" column="blog_id"
                    referenceTable="mprieto_blog" referenceColumn="blog_id"
                    onDelete="CASCADE"/>

        <constraint xsi:type="foreign" referenceId="MPRIETO_BLOG_COMMENTS_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="mprieto_blog_comments" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>

        <index referenceId="MPRIETO_BLOG_COMMENTS_BLOG_ID">
            <column name="blog_id"/>
        </index>
        <index referenceId="MPRIETO_BLOG_COMMENTS_CUSTOMER_ID">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
