{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug (Web)",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "pathMappings": {
        "/var/www/magento": "${workspaceFolder}"
      },
      "log": true
    },
    {
      "name": "Launch currently open script (CLI)",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "port": 9003,
      "pathMappings": {
        "/var/www/magento": "${workspaceFolder}"
      }
    }
  ]
}
